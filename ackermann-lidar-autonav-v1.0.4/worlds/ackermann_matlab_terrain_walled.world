    <!-- Four static collision walls inside +/-20m terrain boundaries.
         Wall bottoms at z=-0.35m, tops at z=2.65m; heightmap max ≈1.176m.
         Interior faces are at x/y=+/-19.1m. -->
    <!-- Solid perimeter wall, physically collidable, not a decorative marker. -->
    <model name="boundary_west">
      <static>true</static>
      <pose>-19.500 0.000 1.150 0 0 0</pose>
      <link name="wall">
        <collision name="solid_wall_collision">
          <geometry><box><size>0.800 40.000 3.000</size></box></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.800 40.000 3.000</size></box></geometry>
          <material>
            <ambient>0.16 0.24 0.34 1</ambient>
            <diffuse>0.30 0.47 0.66 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>
