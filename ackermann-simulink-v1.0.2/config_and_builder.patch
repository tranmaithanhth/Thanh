diff --git a/ackermann_cfg.m b/ackermann_cfg.m
@@
-% Collision-free global guide route for local planning, in meters.
-% This is not claimed to be a computed global optimal path.
-c.route = [0.0 0.0;
-           2.2 1.0;
-           5.3 2.70;
-           8.25 3.45;
-          10.4 2.75;
-          13.3 1.50;
-          16.0 0.60];
+% Recalculate a global route from obstacles and body collision envelope.
+c.globalGridResolution = 0.20;
+c.globalMapPadding = 2.0;
+c.globalRobotRadius = hypot(c.L/2+c.bodyLength/2, c.bodyWidth/2) + c.collisionMargin;
+c.route = ackermann_global_route(c);
